<% layout("../layouts/main") %>
<% const favoritesView = it.show === "favorites" %>
<div class="page-head">
  <h1>Drafts</h1>
  <nav class="segmented" aria-label="Filter drafts">
    <a href="/"<% if (!favoritesView) { %> aria-current="page"<% } %>>
      <span>All</span>
      <span class="count"><%= it.totalCount %></span>
    </a>
    <a href="/?show=favorites"<% if (favoritesView) { %> aria-current="page"<% } %>>
      <svg class="star-icon" width="13" height="13" viewBox="0 0 24 24" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.4l2.65 5.37 5.93.86-4.29 4.18 1.01 5.9L12 16.93l-5.3 2.78 1.01-5.9-4.29-4.18 5.93-.86z"/></svg>
      <span>Favorites</span>
      <span class="count"><%= it.favoriteCount %></span>
    </a>
  </nav>
</div>
<div class="panel">
  <table class="data-table drafts-table" id="drafts-table">
    <thead>
      <tr>
        <th scope="col" class="col-star"><span class="sr-only">Favorite</span></th>
        <th scope="col" class="col-title">
          <div class="th-search">
            <span>Title</span>
            <% if (it.rows.length > 0) { %>
              <label class="search-box">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                <input type="search" placeholder="Search drafts…" aria-label="Search drafts" autocomplete="off" data-table-search="drafts-table" data-search-fields=".cell-title, .draft-desc, .repo-text" />
              </label>
            <% } %>
          </div>
        </th>
        <th scope="col" class="col-repo"><span class="th-label">Repository</span></th>
        <th scope="col" class="col-version hide-md">Version</th>
        <th scope="col" class="col-time hide-xs">Updated</th>
        <th scope="col" class="col-details hide-xs"><span class="sr-only">Details</span></th>
      </tr>
    </thead>
    <tbody>
      <% if (it.totalCount === 0) { %>
        <tr class="empty-row"><td colspan="6">No drafts yet. Publish one with curl and a Token.</td></tr>
      <% } else if (it.rows.length === 0) { %>
        <tr class="empty-row"><td colspan="6">No favorites yet. Star a draft to pin it to the top.</td></tr>
      <% } %>
      <tr class="empty-row search-empty" hidden><td colspan="6">No drafts match your search.</td></tr>
      <% for (const row of it.rows) { %>
        <% const rowClass = [row.isFavorite ? "is-favorite" : "", row.afterFavorites ? "after-favorites" : ""].filter(Boolean).join(" ") %>
        <% const starLabel = row.favorite ? "Remove from favorites" : "Add to favorites" %>
        <tr<% if (rowClass) { %> class="<%= rowClass %>"<% } %>>
          <td class="col-star">
            <form method="post" action="/drafts/<%= row.id %>/favorite">
              <input type="hidden" name="_csrf" value="<%= it.csrf %>" />
              <input type="hidden" name="favorite" value="<%= row.favorite ? '0' : '1' %>" />
              <% if (favoritesView) { %>
                <input type="hidden" name="show" value="favorites" />
              <% } %>
              <button class="star-btn" type="submit" aria-pressed="<%= row.favorite ? 'true' : 'false' %>" aria-label="<%= starLabel %>" title="<%= starLabel %>">
                <svg width="18" height="18" viewBox="0 0 24 24" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.4l2.65 5.37 5.93.86-4.29 4.18 1.01 5.9L12 16.93l-5.3 2.78 1.01-5.9-4.29-4.18 5.93-.86z"/></svg>
              </button>
            </form>
          </td>
          <td class="col-title">
            <a class="cell-title" href="<%= row.publicUrl %>" target="_blank" rel="noreferrer"><%= row.title %></a>
            <% if (row.description) { %>
              <div class="draft-desc" title="<%= row.description %>"><%= row.description %></div>
            <% } %>
            <div class="row-meta">
              <time datetime="<%= row.updatedIso %>" data-local><%= row.updatedLabel %></time>
              <span aria-hidden="true">·</span>
              <span class="row-meta-version"><%= row.versionLabel %></span>
              <span aria-hidden="true">·</span>
              <a href="<%= row.detailUrl %>">Details</a>
            </div>
          </td>
          <td class="col-repo">
            <% if (row.repoName) { %>
              <% if (row.repositoryUrl) { %>
                <a class="repo-link" href="<%= row.repositoryUrl %>" target="_blank" rel="noreferrer" title="Open <%= row.repoLabel %><%= row.isGithub ? ' on GitHub' : '' %>" aria-label="<%= row.repoLabel %><%= row.isGithub ? ' on GitHub' : ' repository' %>">
              <% } else { %>
                <span class="repo-link" title="<%= row.repoLabel %>">
              <% } %>
                <% if (row.isGithub) { %>
                  <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
                <% } else { %>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3v12"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/></svg>
                <% } %>
                <span class="repo-text"><% if (row.repoOwner) { %><span class="repo-owner"><%= row.repoOwner %></span><% } %><span class="repo-name"><% if (row.repoOwner) { %><span class="repo-owner-sep">/</span><% } %><%= row.repoName %></span></span>
              <% if (row.repositoryUrl) { %>
                </a>
              <% } else { %>
                </span>
              <% } %>
            <% } else { %>
              <span class="muted">—</span>
            <% } %>
          </td>
          <td class="col-version hide-md"><%= row.versionLabel %></td>
          <td class="col-time hide-xs"><time datetime="<%= row.updatedIso %>" data-local><%= row.updatedLabel %></time></td>
          <td class="col-details hide-xs"><a href="<%= row.detailUrl %>">Details</a></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
<script src="/static/table-search.js" defer></script>
