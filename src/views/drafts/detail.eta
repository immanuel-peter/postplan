<% layout("../layouts/main") %>
<a class="back" href="/">← Drafts</a>
<h1><%= it.draft.title %></h1>
<% if (it.draft.description) { %>
  <p class="lede"><%= it.draft.description %></p>
<% } %>
<p class="public-url-row">
  <a class="public-url" href="<%= it.draft.publicUrl %>" target="_blank" rel="noreferrer"><%= it.draft.publicUrl %></a>
</p>
<div class="panel">
  <table class="data-table versions-table">
    <thead>
      <tr>
        <th scope="col" class="col-version">Version</th>
        <th scope="col">Commit</th>
        <th scope="col" class="hide-sm">Ref</th>
        <th scope="col" class="col-time">Published</th>
      </tr>
    </thead>
    <tbody>
      <% for (const version of it.versions) { %>
        <tr>
          <td class="col-version">
            <a href="<%= version.versionUrl %>" target="_blank" rel="noreferrer"><%= version.versionLabel %></a>
          </td>
          <td class="mono">
            <%= version.commitLabel %><% if (version.dirty) { %> <span class="chip-dirty">dirty</span><% } %>
          </td>
          <td class="muted mono hide-sm"><%= version.refLabel %></td>
          <td class="col-time"><time datetime="<%= version.publishedIso %>" data-local><%= version.publishedLabel %></time></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
<form class="edit-form" method="post" action="/drafts/<%= it.draft.id %>">
  <input type="hidden" name="_csrf" value="<%= it.csrf %>" />
  <label for="title">Title</label>
  <input id="title" name="title" type="text" value="<%= it.draft.titleValue %>" />
  <label for="description">Description</label>
  <textarea id="description" name="description" rows="3"><%= it.draft.description %></textarea>
  <button class="btn-primary btn-compact" type="submit">Save</button>
</form>
<form class="delete-form" method="post" action="/drafts/<%= it.draft.id %>/delete" onsubmit="return confirm('Delete draft')">
  <input type="hidden" name="_csrf" value="<%= it.csrf %>" />
  <button class="link-button" type="submit">Delete draft</button>
</form>
