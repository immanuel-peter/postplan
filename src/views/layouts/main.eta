<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= it.title %> · PostPlan</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/static/app.css" />
    <link rel="icon" href="/static/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/static/favicon.ico" />
    <link rel="apple-touch-icon" href="/static/apple-touch-icon.png" />
  </head>
  <body>
    <div class="wrap">
      <nav class="nav" aria-label="Dashboard">
        <a href="/" class="<%= it.active === 'drafts' ? 'active' : '' %>">My drafts</a>
        <a href="/keys" class="<%= it.active === 'keys' ? 'active' : '' %>">API keys</a>
      </nav>
      <%~ it.body %>
    </div>
  </body>
</html>
