<% layout("../layouts/main") %>
<h1>Security</h1>
<p class="lede">Passkeys that can unlock this dashboard, and the browsers currently signed in.</p>
<p class="alert-error" id="passkey-error"<% if (!it.error) { %> hidden<% } %>><%= it.error ?? "" %></p>

<section class="panel" aria-labelledby="passkeys-title">
  <div class="panel-head">
    <h2 id="passkeys-title">Passkeys</h2>
    <button class="btn btn-dark" type="button" id="add-passkey">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <path d="M12 5v14" />
        <path d="M5 12h14" />
      </svg>
      <span>Add a passkey</span>
    </button>
  </div>
  <table class="data-table">
    <thead>
      <tr>
        <th scope="col">Name</th>
        <th scope="col" class="col-time hide-xs">Added</th>
        <th scope="col" class="col-time hide-xs">Last used</th>
        <th scope="col" class="col-action"><span class="sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% if (it.passkeys.length === 0) { %>
        <tr class="empty-row"><td colspan="4">No passkeys.</td></tr>
      <% } %>
      <% for (const passkey of it.passkeys) { %>
        <tr>
          <td>
            <div class="cell-title"><%= passkey.name %></div>
            <div class="row-meta">
              <% if (passkey.lastUsedIso) { %>Last used <time datetime="<%= passkey.lastUsedIso %>" data-local><%= passkey.lastUsedLabel %></time><% } else { %>Never used<% } %>
            </div>
          </td>
          <td class="col-time hide-xs">
            <% if (passkey.createdIso) { %><time datetime="<%= passkey.createdIso %>" data-local><%= passkey.createdLabel %></time><% } else { %><%= passkey.createdLabel %><% } %>
          </td>
          <td class="col-time hide-xs">
            <% if (passkey.lastUsedIso) { %><time datetime="<%= passkey.lastUsedIso %>" data-local><%= passkey.lastUsedLabel %></time><% } else { %>Never<% } %>
          </td>
          <td class="col-action">
            <% if (it.removable) { %>
              <form method="post" action="/security/passkeys/<%= passkey.id %>/delete">
                <input type="hidden" name="_csrf" value="<%= it.csrf %>" />
                <button class="btn btn-sm btn-danger-soft" type="submit" aria-label="Remove <%= passkey.name %>">Remove</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
  <p class="panel-foot">Adding a passkey asks for Touch ID again first.</p>
</section>

<section class="panel" aria-labelledby="sessions-title">
  <div class="panel-head">
    <h2 id="sessions-title">Sessions</h2>
    <form method="post" action="/security/sessions/revoke-all">
      <input type="hidden" name="_csrf" value="<%= it.csrf %>" />
      <button class="btn btn-danger" type="submit">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
          <path d="M16 17l5-5-5-5" />
          <path d="M21 12H9" />
        </svg>
        <span>Sign out everywhere</span>
      </button>
    </form>
  </div>
  <table class="data-table">
    <thead>
      <tr>
        <th scope="col">Browser</th>
        <th scope="col" class="col-time hide-xs">Expires</th>
        <th scope="col" class="col-action"><span class="sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% if (it.sessions.length === 0) { %>
        <tr class="empty-row"><td colspan="3">No sessions.</td></tr>
      <% } %>
      <% for (const session of it.sessions) { %>
        <tr>
          <td>
            <div class="cell-title"><%= session.label %><% if (session.current) { %><span class="chip-dirty">This device</span><% } %></div>
            <div class="row-meta">
              <% if (session.expiresIso) { %>Expires <time datetime="<%= session.expiresIso %>" data-local><%= session.expiresLabel %></time><% } else { %>Expires <%= session.expiresLabel %><% } %>
            </div>
          </td>
          <td class="col-time hide-xs">
            <% if (session.expiresIso) { %><time datetime="<%= session.expiresIso %>" data-local><%= session.expiresLabel %></time><% } else { %><%= session.expiresLabel %><% } %>
          </td>
          <td class="col-action">
            <% if (!session.current) { %>
              <form method="post" action="/security/sessions/<%= session.id %>/revoke">
                <input type="hidden" name="_csrf" value="<%= it.csrf %>" />
                <button class="btn btn-sm btn-danger-soft" type="submit" aria-label="Revoke <%= session.label %>">Revoke</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
  <p class="panel-foot">Sessions last 7 days. Locking ends this one only.</p>
</section>

<script src="/static/webauthn.js"></script>
<script>
  (function () {
    var button = document.getElementById("add-passkey");
    var error = document.getElementById("passkey-error");
    var csrf = <%~ JSON.stringify(it.csrf) %>;

    button.addEventListener("click", async function () {
      error.hidden = true;
      button.disabled = true;
      var name = window.prompt("Name this passkey", "Backup passkey");
      if (name === null) {
        button.disabled = false;
        return;
      }
      try {
        var response = await fetch("/auth/register/options", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "same-origin",
          body: JSON.stringify({ _csrf: csrf }),
        });
        if (!response.ok) {
          throw new Error("Could not start enrollment.");
        }
        await postplanEnroll(await response.json(), name, csrf);
      } catch (err) {
        button.disabled = false;
        error.textContent = err && err.message ? err.message : "That passkey wasn’t created.";
        error.hidden = false;
      }
    });
  })();
</script>
