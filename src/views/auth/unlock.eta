<% layout("../layouts/auth") %>
<h1>Unlock PostPlan</h1>
<p class="lede gate-lede">This dashboard is private. Verify with a passkey to continue.</p>
<p class="alert-error" id="unlock-error" hidden></p>
<button class="btn-primary btn-icon" type="button" id="unlock">
  <svg class="fingerprint" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 11v2.5a9 9 0 0 1-.9 4" />
    <path d="M8.5 20.2A12 12 0 0 0 10 14v-3a2 2 0 0 1 4 0v3a15 15 0 0 0 .6 4.3" />
    <path d="M17 18.5A18 18 0 0 1 16.4 14v-3a4.4 4.4 0 0 0-8.8 0v3a8.8 8.8 0 0 1-1.3 4.6" />
    <path d="M4.5 15.5A9 9 0 0 0 5 11a7 7 0 0 1 3.2-5.9" />
    <path d="M19.5 14.5A10 10 0 0 1 19.3 11 7 7 0 0 0 11 4.1" />
  </svg>
  <span id="unlock-label">Unlock with passkey</span>
</button>
<p class="note" id="unlock-note">Touch ID, or your device password if you prefer.</p>
<div class="gate-foot">
  <% if (it.recoverable) { %>
    <p class="note">Lost every passkey? <a href="/setup">Use your recovery secret</a> to enroll a replacement.</p>
  <% } else { %>
    <p class="note">Published Drafts and Assets stay public. Only the dashboard is locked.</p>
  <% } %>
</div>
<script src="/static/webauthn.js"></script>
<script>
  (function () {
    var button = document.getElementById("unlock");
    var label = document.getElementById("unlock-label");
    var note = document.getElementById("unlock-note");
    var error = document.getElementById("unlock-error");
    var next = <%~ JSON.stringify(it.next) %>;

    button.addEventListener("click", function () {
      error.hidden = true;
      button.classList.add("is-waiting");
      button.disabled = true;
      label.textContent = "Waiting for your passkey…";
      note.textContent = "Your browser is asking for verification. Finish it there.";

      postplanUnlock(next).catch(function (err) {
        button.classList.remove("is-waiting");
        button.disabled = false;
        label.textContent = "Try again";
        note.textContent = "Touch ID, or your device password if you prefer.";
        error.textContent = err && err.message ? err.message : "That passkey wasn’t verified. Try again.";
        error.hidden = false;
      });
    });
  })();
</script>
